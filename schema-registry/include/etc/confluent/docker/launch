# JMX settings
if [ "${SCHEMA_REGISTRY_JMX_REMOTE_ENABLE:-false}" = "true" ]; then
  if [ -z "$SCHEMA_REGISTRY_JMX_PORT" ]; then
    echo "SCHEMA_REGISTRY_JMX_REMOTE_ENABLE=true requires SCHEMA_REGISTRY_JMX_PORT to be set." >&2
    exit 1
  fi

  # Remote JMX explicitly enabled — require authentication and read-only
  # authorization, otherwise any client on the network could invoke MBean
  # operations
  export JMX_PORT=$SCHEMA_REGISTRY_JMX_PORT

  JMX_CONFIG_DIR="${SCHEMA_REGISTRY_JMX_CONFIG_DIR:-/etc/schema-registry/secrets}"
  JMX_PASSWORD_FILE="${SCHEMA_REGISTRY_JMX_PASSWORD_FILE:-$JMX_CONFIG_DIR/jmxremote.password}"
  JMX_ACCESS_FILE="${SCHEMA_REGISTRY_JMX_ACCESS_FILE:-$JMX_CONFIG_DIR/jmxremote.access}"

  if [ ! -f "$JMX_PASSWORD_FILE" ] || [ ! -f "$JMX_ACCESS_FILE" ]; then
    if ! /etc/confluent/docker/setup-jmx-security.sh "$JMX_PASSWORD_FILE" "$JMX_ACCESS_FILE"; then
      echo "Failed to generate JMX password/access files." >&2
      exit 1
    fi
  fi

  # The JMX client needs to be able to connect to java.rmi.server.hostname.
  # The default for bridged n/w is the bridged IP so you will only be able to connect from another docker container.
  # For host n/w, this is the IP that the hostname on the host resolves to.
  #
  # If you have more that one n/w configured, hostname -i gives you all the IPs,
  # the default is to pick the first IP (or network).
  export SCHEMA_REGISTRY_JMX_HOSTNAME=${SCHEMA_REGISTRY_JMX_HOSTNAME:-$(hostname -i | cut -d" " -f1)}

  # Appended last so these win on duplicate -D flags: Java takes the last
  # occurrence, so this always ends up authenticated/readonly even if
  # SCHEMA_REGISTRY_JMX_OPTS already set something else for JMX.
  SCHEMA_REGISTRY_JMX_OPTS="${SCHEMA_REGISTRY_JMX_OPTS:-} -Dcom.sun.management.jmxremote -Dcom.sun.management.jmxremote.ssl=false -Djava.rmi.server.hostname=$SCHEMA_REGISTRY_JMX_HOSTNAME -Dcom.sun.management.jmxremote.local.only=false -Dcom.sun.management.jmxremote.rmi.port=$JMX_PORT -Dcom.sun.management.jmxremote.port=$JMX_PORT -Dcom.sun.management.jmxremote.authenticate=true -Dcom.sun.management.jmxremote.password.file=$JMX_PASSWORD_FILE -Dcom.sun.management.jmxremote.access.file=$JMX_ACCESS_FILE"
elif [ -z "$SCHEMA_REGISTRY_JMX_OPTS" ]; then
  # Default: local-only JMX. In-process monitoring (OTel agent,
  # JMX Prometheus exporter, etc.) continues to work since they
  # access MBeans via the in-process JVM, not the remote port.
  SCHEMA_REGISTRY_JMX_OPTS="-Dcom.sun.management.jmxremote -Dcom.sun.management.jmxremote.ssl=false -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.local.only=true"
fi

# Must export: schema-registry-run-class (a separate, packaged script) has
# its own insecure JMX fallback that only backs off if this is already set.
export SCHEMA_REGISTRY_JMX_OPTS

echo "===> Launching ${COMPONENT} ... "
exec "${COMPONENT}"-start /etc/"${COMPONENT}"/"${COMPONENT}".properties
